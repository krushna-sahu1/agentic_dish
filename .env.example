# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, only for `npm run db:migrate` / `db:seed` (Project Settings → Database)
SUPABASE_DB_URL=

# --- LLM: DeepSeek (OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Set to 1 to use the deterministic scripted model (CI / e2e, no API key needed)
LLM_MOCK=

# --- Razorpay (test mode keys: Dashboard → Settings → API Keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Agentic Dish <orders@resend.dev>"
OWNER_ALERT_EMAIL=

# --- Misc ---
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESTAURANT_TIMEZONE=Asia/Kolkata
COPILOTKIT_TELEMETRY_DISABLED=true

# --- Jarvis voice assistant (Deepgram Voice Agent: Nova-3 STT + Deepgram-managed LLM + Aura-2 TTS) ---
# Server-only. Needs Member permissions (used to mint 30-second browser tokens). Never expose to the client.
DEEPGRAM_API_KEY=
# Optional overrides (defaults shown)
# DEEPGRAM_THINK_PROVIDER=open_ai
# DEEPGRAM_THINK_MODEL=gpt-4.1-mini
# DEEPGRAM_VOICE=aura-2-orion-en
# DEEPGRAM_LISTEN_MODEL=nova-3
# DEEPGRAM_LISTEN_LANGUAGE=en
